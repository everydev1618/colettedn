# Required for domain name generation
ANTHROPIC_API_KEY=your-api-key-here

# Optional: Server port (defaults to 8080)
PORT=8080

# Namecheap API (for availability checking)
# Sign up at https://www.sandbox.namecheap.com for sandbox testing
# Activate API at https://ap.www.sandbox.namecheap.com/Profile/Tools/ApiAccess
NAMECHEAP_API_USER=your-api-user
NAMECHEAP_API_KEY=your-api-key
NAMECHEAP_USERNAME=your-username
NAMECHEAP_CLIENT_IP=your-public-ip
NAMECHEAP_SANDBOX=true

# Cache database path (defaults to cache.db)
# CACHE_DB_PATH=cache.db
